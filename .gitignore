# Project Backup Pilot local files
project-backup-pilot.json
*.local.json

# Logs and temporary files
*.log
*.tmp
*.bak

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
# --- git-backup safety rules ---
# Local secrets and machine-specific environment files
**/.env
**/.env.*
!**/.env.example
!**/.env.exemple

# PHP config files that commonly contain credentials. Commit *.example.php instead.
**/config.php
**/db.php
**/conexaodb.php
**/*conexao*.php
**/whatsapp.php
**/ai_config.php
!**/*.example.php

# Dependencies, build output, caches and logs
**/node_modules/
**/vendor/
**/.next/
**/.nuxt/
**/dist/
**/build/
**/.vite/
**/coverage/
**/.cache/
**/.gradle/
**/__pycache__/
**/.venv/
**/venv/
**/bootstrap/cache/*.php
**/storage/framework/cache/
**/storage/framework/sessions/
**/storage/framework/views/
**/storage/logs/
**/*.log

# Large local backup archives. Keep these outside GitHub or back them up with a file backup tool.
*.zip
*.rar
*.7z
*.bak
*.hprof
*.apk
*.jks
*.keystore
keystore.properties
local.properties
**/*.zip
**/*.rar
**/*.7z
**/*.bak
**/*.hprof
**/*.apk
**/*.jks
**/*.keystore
**/keystore.properties
**/local.properties

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
# --- end git-backup safety rules ---

